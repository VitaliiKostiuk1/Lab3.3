<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BinaryFormatter позначений як застарілий (небезпечний), але саме його
         вимагає лабораторна для демонстрації бінарної серіалізації.
         Працює на .NET 8; у .NET 9+ BinaryFormatter повністю прибрано. -->
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0050</NoWarn>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

</Project>
